# CareScope Analytics - Environment Variables Template
VITE_APP_TITLE="CareScope Analytics"
VITE_APP_ENV="production"
VITE_API_BASE_URL="https://api.carescope-analytics.local/v1"
VITE_ENABLE_MOCK_TELEMETRY="true"
